rules_version = '2';

// Security rules for the Book (car wash bookkeeping).
//
// The app authenticates the operator with a client-side PIN, which never reaches
// Firestore. The real boundary is here: every request must carry an authenticated
// session (the client signs in anonymously — see src/lib/firebase.ts), and only the
// three car-wash collections are reachable. Everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in client (anonymous auth counts) may read and write the car-wash books.
    function signedIn() {
      return request.auth != null;
    }

    // Sales ledger — one document per recorded wash.
    //
    // Deletes are allowed: a wash recorded against the wrong customer, or recorded twice
    // because the tablet looked like it had not saved, has to come off the day's takings
    // rather than be carried as a correction nobody can interpret. The desk restricts the
    // action to the admin PIN and reverses the loyalty point on the way out; that gate is
    // client-side, so anyone who can reach the collection at all can delete from it. If the
    // books ever need to be tamper-evident, this is the line to close, and the app needs a
    // voided flag instead.
    match /car_wash_sales/{saleId} {
      allow read, create, update, delete: if signedIn();
    }

    // Loyalty members — created on first sale, points updated on each subsequent one.
    // Never deleted: a member's row is what the printed card number resolves to, and
    // removing it orphans a card that is already in a customer's wallet.
    match /car_wash_loyalty/{memberId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    // Expenses ledger.
    match /car_wash_expenses/{expenseId} {
      allow read, create, update, delete: if signedIn();
    }

    // Deny everything else outright.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
